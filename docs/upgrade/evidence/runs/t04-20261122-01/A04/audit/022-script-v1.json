    "script_id": "episode",
    "sections": [
      {
        "section_id": "sec_001",
        "title": "同一张图，两次打开",
        "narration": "你昨天见过的这张图标，今天再打开，还要从头下载吗？我们跟着它走两趟。",
        "claim_ids": [
          "reuse"
        ],
        "pronunciation": [],
        "visual_intent": "并排的两扇浏览器窗口，固定一枚黄色图标。",
        "duration_estimate_frames": 240,
        "cues": [
          {
            "cue_id": "cue_001",
            "text": "你昨天见过的这张图标"
          },
          {
            "cue_id": "cue_002",
            "text": "我们跟着它走两趟"
          }
        ]
      },
      {
        "section_id": "sec_002",
        "title": "第一次走多远",
        "narration": "第一趟，假设浏览器手边还没有副本。它向服务器要图标。箭头走过去，再带着图片走回来，屏幕上才有了这张图。如果响应允许缓存，浏览器可以把这次拿到的内容留下，供之后的请求使用。",
        "claim_ids": [
          "reuse"
        ],
        "pronunciation": [],
        "visual_intent": "把浏览器和服务器放在画面两端，显示请求和返回。",
        "duration_estimate_frames": 660,
        "cues": [
          {
            "cue_id": "cue_003",
            "text": "第一趟"
          },
          {
            "cue_id": "cue_004",
            "text": "它向服务器要图标"
          },
          {
            "cue_id": "cue_005",
            "text": "如果响应允许缓存"
          }
        ]
      },
      {
        "section_id": "sec_003",
        "title": "第二次发生了什么",
        "narration": "第二趟，我们仍然打开同一页。先把目光留在浏览器这边，看它能不能找到匹配的副本。找到之后还要看条件。假设这份响应允许复用，也还在有效的新鲜期内。在这个例子里，浏览器直接拿本地保存的图标来用。刚才那条通往服务器的长箭头，这一次可以省掉。把两趟路并排看。你省下的是一次来回等待，以及再次传输图片的时间。",
        "claim_ids": [
          "reuse",
          "fresh"
        ],
        "pronunciation": [],
        "visual_intent": "同图同色重放，依次点亮匹配、可复用和新鲜度。",
        "duration_estimate_frames": 1200,
        "cues": [
          {
            "cue_id": "cue_006",
            "text": "第二趟"
          },
          {
            "cue_id": "cue_007",
            "text": "找到之后还要看条件"
          },
          {
            "cue_id": "cue_008",
            "text": "在这个例子里"
          },
          {
            "cue_id": "cue_009",
            "text": "把两趟路并排看"
          }
        ]
      },
      {
        "section_id": "sec_004",
        "title": "过期之后",
        "narration": "再把时钟拨快。现在副本已经过期，浏览器手里的内容还能用吗？先看它有没有可用的验证信息。有了验证信息，浏览器可以先询问服务器。资源没变时，服务器可以返回三零四，让浏览器继续用原来的内容。如果内容已经更新，就可能需要传回新的正文。两种情况都联系了服务器，真正传输的数据量却可能很不一样。",
        "claim_ids": [
          "validate"
        ],
        "pronunciation": [
          {
            "term": "304",
            "reading": "三零四"
          }
        ],
        "visual_intent": "把时间标记翻到过期位置，展示验证的两个出口。",
        "duration_estimate_frames": 1050,
        "cues": [
          {
            "cue_id": "cue_010",
            "text": "再把时钟拨快"
          },
          {
            "cue_id": "cue_011",
            "text": "有了验证信息"
          },
          {
            "cue_id": "cue_012",
            "text": "如果内容已经更新"
          }
        ]
      },
      {
        "section_id": "sec_005",
        "title": "用一句话带走",
        "narration": "记住三种动作。条件合适时直接用，需要确认时先问一句，拿到新内容时再替换。下次看见同一张图瞬间出现，你就能说清，它可能省掉了哪一段路。",
        "claim_ids": [
          "fresh",
          "validate"
        ],
        "pronunciation": [],
        "visual_intent": "复用、询问、取回三张卡片并列，回扣片头。",
        "duration_estimate_frames": 450,
        "cues": [
          {
            "cue_id": "cue_013",
            "text": "记住三种动作"
          },
          {
            "cue_id": "cue_014",
            "text": "下次看见同一张图瞬间出现"
          }
        ]
      }
    ]
  },
