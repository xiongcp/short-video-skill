{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.animation-studio.invalid/v1/common.schema.json",
  "title": "跨阶段值类型",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "AssetRef": {
      "type": "string",
      "pattern": "^asset://[a-z][a-z0-9_-]*/[a-z][a-z0-9_-]*/v[1-9][0-9]*$"
    },
    "Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "FrameRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "ReviewStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "Mode": {
      "enum": [
        "quality",
        "draft"
      ]
    },
    "Gate": {
      "enum": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "Cost": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "estimated_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_minor": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "currency",
        "estimated_minor",
        "actual_minor"
      ],
      "additionalProperties": false
    },
    "CharacterAction": {
      "type": "object",
      "properties": {
        "character_ref": {
          "$ref": "common.schema.json#/$defs/AssetRef"
        },
        "angle": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "expression": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "gesture": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "gaze": {
          "$ref": "common.schema.json#/$defs/Id"
        }
      },
      "required": [
        "character_ref",
        "angle",
        "expression",
        "gesture",
        "gaze"
      ],
      "additionalProperties": false
    },
    "MediaSpec": {
      "type": "object",
      "properties": {
        "width": {
          "const": 1920
        },
        "height": {
          "const": 1080
        },
        "fps": {
          "const": 30
        },
        "sample_rate_hz": {
          "const": 48000
        }
      },
      "required": [
        "width",
        "height",
        "fps",
        "sample_rate_hz"
      ],
      "additionalProperties": false
    },
    "VisualCue": {
      "type": "object",
      "properties": {
        "target_ref": {
          "$ref": "common.schema.json#/$defs/AssetRef"
        },
        "element_id": {
          "$ref": "common.schema.json#/$defs/Id"
        },
        "operation": {
          "enum": [
            "show",
            "highlight",
            "dim",
            "pan_to"
          ]
        },
        "at_local_frame": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "target_ref",
        "element_id",
        "operation",
        "at_local_frame"
      ],
      "additionalProperties": false
    }
  }
}
