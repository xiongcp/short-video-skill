{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.animation-studio.invalid/v1/character.schema.json",
  "title": "CharacterProfile · 主持人能力表",
  "type": "object",
  "properties": {
    "project_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "character_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "character_ref": {
      "$ref": "common.schema.json#/$defs/AssetRef"
    },
    "style_lock": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rig_ref": {
      "$ref": "common.schema.json#/$defs/AssetRef"
    },
    "voice_ref": {
      "$ref": "common.schema.json#/$defs/AssetRef"
    },
    "supported_angles": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "expressions": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "gestures": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/Id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parameter_id": {
            "type": "string",
            "minLength": 1
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        },
        "required": [
          "parameter_id",
          "min",
          "max"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project_id",
    "version",
    "character_id",
    "character_ref",
    "style_lock",
    "rig_ref",
    "voice_ref",
    "supported_angles",
    "expressions",
    "gestures",
    "parameters"
  ],
  "additionalProperties": false
}
