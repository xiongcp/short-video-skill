{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.animation-studio.invalid/v1/storyboard.schema.json",
  "title": "Storyboard · 规划或对齐后的分镜",
  "type": "object",
  "properties": {
    "project_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "script_version": {
      "type": "integer",
      "minimum": 1
    },
    "timing_basis": {
      "enum": [
        "planned",
        "aligned"
      ]
    },
    "media": {
      "$ref": "common.schema.json#/$defs/MediaSpec"
    },
    "total_frames": {
      "type": "integer",
      "minimum": 1
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chapter_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "section_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "frame_range": {
            "$ref": "common.schema.json#/$defs/FrameRange"
          },
          "continuity_in": {
            "type": "string",
            "minLength": 1
          },
          "continuity_out": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "chapter_id",
          "title",
          "section_ids",
          "frame_range",
          "continuity_in",
          "continuity_out"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "chapter_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "section_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "frame_range": {
            "$ref": "common.schema.json#/$defs/FrameRange"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "camera": {
            "enum": [
              "medium",
              "close",
              "wide",
              "insert",
              "push_in"
            ]
          },
          "scene_ref": {
            "$ref": "common.schema.json#/$defs/AssetRef"
          },
          "scene_layers": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/AssetRef"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "character_actions": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/CharacterAction"
            }
          },
          "audio_anchors": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/Id"
            },
            "uniqueItems": true
          },
          "approval": {
            "$ref": "common.schema.json#/$defs/ReviewStatus"
          },
          "visual_cues": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/VisualCue"
            }
          }
        },
        "required": [
          "shot_id",
          "chapter_id",
          "section_id",
          "frame_range",
          "purpose",
          "camera",
          "scene_ref",
          "scene_layers",
          "character_actions",
          "audio_anchors",
          "approval",
          "visual_cues"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "project_id",
    "version",
    "script_version",
    "timing_basis",
    "media",
    "total_frames",
    "chapters",
    "shots"
  ],
  "additionalProperties": false
}
