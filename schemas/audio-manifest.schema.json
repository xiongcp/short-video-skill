{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.animation-studio.invalid/v1/audio-manifest.schema.json",
  "title": "AudioManifest · 逐段音频与混音母带",
  "type": "object",
  "properties": {
    "project_id": {
      "$ref": "common.schema.json#/$defs/Id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "script_version": {
      "type": "integer",
      "minimum": 1
    },
    "master_ref": {
      "$ref": "common.schema.json#/$defs/AssetRef"
    },
    "sample_rate_hz": {
      "const": 48000
    },
    "duration_samples": {
      "type": "integer",
      "minimum": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "$ref": "common.schema.json#/$defs/Id"
          },
          "audio_ref": {
            "$ref": "common.schema.json#/$defs/AssetRef"
          },
          "start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "end_sample": {
            "type": "integer",
            "minimum": 1
          },
          "voice_ref": {
            "$ref": "common.schema.json#/$defs/AssetRef"
          },
          "origin": {
            "enum": [
              "tts",
              "import"
            ]
          },
          "provider_or_recordist": {
            "type": "string",
            "minLength": 1
          },
          "settings_ref": {
            "$ref": "common.schema.json#/$defs/AssetRef"
          }
        },
        "required": [
          "section_id",
          "audio_ref",
          "start_sample",
          "end_sample",
          "voice_ref",
          "origin",
          "provider_or_recordist",
          "settings_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "stems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "voice",
              "music",
              "sfx"
            ]
          },
          "audio_ref": {
            "$ref": "common.schema.json#/$defs/AssetRef"
          },
          "start_sample": {
            "type": "integer",
            "minimum": 0
          },
          "end_sample": {
            "type": "integer",
            "minimum": 1
          },
          "gain_db": {
            "type": "number"
          }
        },
        "required": [
          "kind",
          "audio_ref",
          "start_sample",
          "end_sample",
          "gain_db"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "project_id",
    "version",
    "script_version",
    "master_ref",
    "sample_rate_hz",
    "duration_samples",
    "segments"
  ],
  "additionalProperties": false
}
